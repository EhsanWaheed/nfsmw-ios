# Everything made from your own game files stays local.
/original/
/analysis/
/build/
/dist/
/.venv/
__pycache__/
*.pyc
.DS_Store
# Files the setup builds (it writes them to build/generated; never commit copies):
mods/core/nfsmw/*.fx
mods/core/nfsmw/clean-chain.txt
mods/core/nfsmw/clean-pools.bin
mods/core/nfsmw/x360-textures.map
mods/core/nfsmw/texture-pack.map
mods/core/nfsmw/xenon/
# Texture packs, shader caches and upscaler models are made or kept on the player's Mac only.
*.dds
*.tsv
*.fx.o
*.safetensors
*.pth
RemasterPack/
PbrPilot/
ShaderWarmSeed/
ShaderWarm/
HDTextures/
/derived/
# Game and build file types never belong in the repository.
CMakeUserPresets.json
/.tools/
/.pytest_cache/
*.o
*.a
*.dylib
*.dSYM/
*.app/
*.exe
*.dll
*.zip
*.rar
*.pack
*.sf2
